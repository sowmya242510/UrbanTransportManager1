
pipeline {
    agent any

    tools {
        nodejs 'NodeJS'
    }

    stages {
        stage('Checkout') {
            steps {
                checkout scm
            }
        }

        stage('Install Dependencies') {
            steps {
                dir('UrbanTransportManager1-NodeJS') {
                    sh 'npm install'
                }
            }
        }

        stage('Validate') {
            steps {
                dir('UrbanTransportManager1-NodeJS') {
                    sh 'npm run check'
                }
            }
        }

        stage('Test') {
            steps {
                dir('UrbanTransportManager1-NodeJS') {
                    sh 'npm test'
                }
            }
        }

        stage('OWASP Dependency Check') {
            steps {
                dependencyCheck(
                    odcInstallation: 'DependencyCheck',
                    additionalArguments: '''
                        --project "UrbanTransportManager1"
                        --scan UrbanTransportManager1-NodeJS
                        --format XML
                        --format HTML
                        --out dependency-check-results
                    '''
                )
            }
            post {
                always {
                    dependencyCheckPublisher(
                        pattern: 'dependency-check-results/dependency-check-report.xml'
                    )
                    archiveArtifacts(
                        artifacts: 'dependency-check-results/dependency-check-report.html',
                        allowEmptyArchive: true
                    )
                }
            }
        }

        stage('SonarQube Analysis') {
            steps {
                dir('UrbanTransportManager1-NodeJS') {
                    withSonarQubeEnv('SonarQube') {
                        script {
                            def scannerHome = tool 'SonarScanner'
                            sh "${scannerHome}/bin/sonar-scanner"
                        }
                    }
                }
            }
        }

        stage('Quality Gate') {
            steps {
                timeout(time: 5, unit: 'MINUTES') {
                    waitForQualityGate abortPipeline: true
                }
            }
        }
    }
}
